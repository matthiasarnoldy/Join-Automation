    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "=/**\n * Builds a normalized task payload for Firebase persistence.\n *\n * The payload:\n * - generates a unique string ID from the current timestamp,\n * - maps required fields from `$json.task`,\n * - sanitizes `priority` and `category` against allowed values,\n * - normalizes `subtasks` into `{ text, completed }` objects,\n * - sets default workflow metadata (`status`, `createdBySource`).\n *\n * Intended for n8n expression mode in an Edit Fields / Set node.\n *\n * @returns \n *   id: string,\n *   title: string,\n *   description: string,\n *   date: string,\n *   priority: string,\n *   category: \"technical-task\" | \"user-story\",\n *   assigned: unknown[],\n *   subtasks: { text: string, completed: boolean }[],\n *   status: \"triage\",\n *   createdByName: string,\n *   createdBySource: \"extern\"\n * }} Normalized task object ready to be stored.\n */\n{{ {\n  id: String(Date.now()),\n  title: $json.task.title,\n  description: $json.task.description || \"\",\n  date: $json.task.date,\n  priority: [\"urgent\",\"medium\",\"low\"].includes($json.task.priority) ? $json.task.priority : \"\",\n  category: [\"technical-task\",\"user-story\"].includes($json.task.category) ? $json.task.category : \"user-story\",\n  assigned: [],\n  subtasks: Array.isArray($json.task.subtasks)\n    ? $json.task.subtasks.map(s => ({ text: String(s), completed: false }))\n    : [],\n  status: \"triage\",\n  createdByName: $json.task.createdByName || \"\",\n  createdBySource: \"extern\"\n} }}",
        "options": {}
      },
