    {
      "parameters": {
        "jsCode": "/**\n * Normalizes agent output into a consistent `task` object.\n *\n * The function reads the first available payload from `output`, `text`, `response`,\n * or falls back to the full current JSON. If the payload is a string, it attempts\n * to parse it as JSON. If parsing fails, it returns a safe fallback `{ isTask: false }`.\n *\n * The original item fields are preserved and extended with `task`.\n *\n * @returns {{ json: Record<string, unknown> & { task: unknown } }[]} An n8n item array with a normalized `task` field.\n */\nconst raw = $json.output ?? $json.text ?? $json.response ?? $json;\n\nlet task = raw;\nif (typeof raw === \"string\") {\n  try {\n    task = JSON.parse(raw);\n  } catch {\n    task = { isTask: false };\n  }\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      task\n    }\n  }\n];"
      },
